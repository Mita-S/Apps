# Copy this file to .streamlit/secrets.toml and fill in the real values.
# secrets.toml must NEVER be committed -- it's already in .gitignore.

# --- Google sign-in (required) -- see ../SETUP.md, part 1 -------------------
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate with: python3 -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Admin allowlist (required) --------------------------------------------
# Any signed-in Google account can use the Collect page; only emails listed
# here get the Review page. Comma-separated string or a TOML list both work.
[admin]
emails = "you@example.com"

# --- Destination Sheet (required) -- see ../SETUP.md, part 2 ----------------
# The file ID from the Sheet's URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
[sheet]
id = "the Google Sheet's file ID"

# --- Service-account key (required) -- see ../SETUP.md, part 2 --------------
# Paste the downloaded JSON key here as a TOML table. The Sheet above must be
# shared with `client_email` as an Editor, or every save fails with a
# permission error.
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@<project-id>.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
